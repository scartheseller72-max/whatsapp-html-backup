{
  "name": "whatsapp-html-backup",
  "version": "2.0.0",
  "description": "Export your own WhatsApp chats to a beautiful, human-readable Telegram-style HTML archive — per-chat pages, stats dashboard, media gallery, in-chat search, plus PDF/JSON/CSV/single-file export and an optional browser Web UI.",
  "type": "commonjs",
  "main": "src/index.js",
  "bin": {
    "wa-backup": "bin/wa-backup.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "backup": "node src/index.js",
    "wizard": "node src/index.js --wizard",
    "serve": "node src/index.js --serve",
    "logout": "node src/index.js --logout",
    "test": "node --test"
  },
  "keywords": [
    "whatsapp",
    "backup",
    "export",
    "html",
    "archive",
    "pdf",
    "json",
    "whatsapp-web.js",
    "chat-export"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "whatsapp-web.js": "^1.26.0",
    "qrcode-terminal": "^0.12.0",
    "qrcode": "^1.5.3",
    "express": "^4.19.2"
  }
}
